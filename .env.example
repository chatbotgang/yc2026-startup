# Stripe secret or restricted key (use test mode: sk_test_... / rk_test_...)
# Restricted key permissions: Checkout Sessions (write), Customers (write), PaymentIntents (write)
STRIPE_SECRET_KEY=
# Webhook signing secret (local: printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Customer that holds the stored-value balance (create with `pnpm wallet:init`)
STRIPE_WALLET_CUSTOMER_ID=
# Optional: payment method configuration limiting Checkout to card + Apple Pay + Google Pay
# (test and live modes have different IDs)
STRIPE_PAYMENT_METHOD_CONFIG=
# Optional: public URL used for Checkout redirects (defaults to the request host)
SITE_URL=
